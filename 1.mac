# 定义第一个源
#/gps/source/intensity 1
#/gps/particle gamma
#/gps/pos/type Point
#/gps/pos/centre 0 0 0 cm
#/gps/ang/type iso
#/gps/ene/type Mono
#/gps/ene/mono 1.33 MeV

# 添加第二个源

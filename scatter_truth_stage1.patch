+bool WriteRawKeV(const G4String& path, const G4DataVector& data)
+{
+  std::ofstream out(path.c_str(), std::ios::binary);
+  if (!out) {
+    G4cerr << "Cannot open output file: " << path << G4endl;
+    return false;
+  }
+  for (const auto value : data) {
+    const G4double valueKeV = value / keV;
+    out.write(reinterpret_cast<const char*>(&valueKeV), sizeof(G4double));
+  }
+  return static_cast<bool>(out);
+}
+
+G4double RelativeClosureError(const G4DataVector& total,
+                              const G4DataVector& primary,
+                              const G4DataVector& scatter)
+{
+  const size_t n = std::min(total.size(), std::min(primary.size(), scatter.size()));
+  G4double diff2 = 0.0;
+  G4double total2 = 0.0;
+  for (size_t i = 0; i < n; ++i) {
+    const G4double diff = total[i] - primary[i] - scatter[i];
+    diff2 += diff * diff;
+    total2 += total[i] * total[i];
+  }
+  return (total2 > 0.0) ? std::sqrt(diff2 / total2) : 0.0;
+}

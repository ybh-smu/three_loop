diff -ruN /mnt/data/geant4_proj/geant4#U9879#U76ee/src/SteppingAction.cc /mnt/data/geant4_scatter_truth_v1/src/SteppingAction.cc
--- /mnt/data/geant4_proj/geant4#U9879#U76ee/src/SteppingAction.cc	1970-01-01 00:00:00.000000000 +0000

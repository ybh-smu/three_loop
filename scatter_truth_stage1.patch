+#include "SteppingAction.hh"
+
+#include "G4Gamma.hh"
+#include "G4LogicalVolume.hh"
+#include "G4Step.hh"
+#include "G4StepPoint.hh"
+#include "G4TouchableHandle.hh"
+#include "G4Track.hh"
+#include "G4VPhysicalVolume.hh"
+#include "G4VProcess.hh"
+#include "TrackInformation.hh"
+
+namespace {
+
+bool StartsWith(const G4String& value, const G4String& prefix)
+{
+  return value.rfind(prefix, 0) == 0;
+}
+
+bool IsKnownObjectVolumeName(const G4String& logicalName,
+                             const G4String& physicalName)
+{
+  // Default water/object and generic phantom.
+  if (logicalName == "Object" || physicalName == "Object" ||
+      logicalName == "PhantomBox" || physicalName == "PhantomObject" ||
+      logicalName == "PhantomVoxel" || physicalName == "PhantomVoxel") {
+    return true;
+  }
+
+  // Brain phantom.
+  if (logicalName == "PhantomContainer" || physicalName == "PhantomContainer" ||
+      logicalName == "VoxelLogic" || StartsWith(physicalName, "BrainVoxels")) {
+    return true;
+  }
+
+  // CT voxel phantom (missing in the original implementation).
+  if (logicalName == "CTPhantomContainer" || physicalName == "CTPhantomContainer" ||
+      logicalName == "CTVoxelLogic" || StartsWith(physicalName, "CTVoxels")) {
+    return true;
+  }
+
+  // Corgi/Defrise phantom.
+  if (logicalName == "CorgiDefriseCylinder" ||
+      physicalName == "CorgiDefriseCylinder" || logicalName == "DefriseDisk" ||
+      StartsWith(physicalName, "CorgiDefriseDisk_")) {
+    return true;
+  }
+
+  // Five-cylinder phantom variants used in this project.
+  if (StartsWith(logicalName, "CylinderLogic_") ||
+      StartsWith(physicalName, "CylinderPhys_")) {
+    return true;
+  }
+
+  return false;
+}
+
+bool IsInsideScannedObject(const G4StepPoint* point)
+{
+  if (point == nullptr) return false;
+  const auto touchable = point->GetTouchableHandle();
+  if (!touchable) return false;
+
+  // Check the current volume and all ancestors.  This is more robust than
+  // checking only the current physical volume because inserts/voxels are
+  // daughters of an object container.
+  const G4int depth = touchable->GetHistoryDepth();
+  for (G4int level = 0; level <= depth; ++level) {
+    const auto* volume = touchable->GetVolume(level);
+    if (volume == nullptr || volume->GetLogicalVolume() == nullptr) continue;
+    if (IsKnownObjectVolumeName(volume->GetLogicalVolume()->GetName(),
+                                volume->GetName())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+SteppingAction::SteppingAction() = default;
+SteppingAction::~SteppingAction() = default;
+
+void SteppingAction::UserSteppingAction(const G4Step* step)
+{
+  if (step == nullptr) return;
+
+  G4Track* track = step->GetTrack();
+  if (track == nullptr || track->GetDefinition() != G4Gamma::Gamma()) {
+    return;
+  }
+
+  if (!IsInsideScannedObject(step->GetPreStepPoint())) {
+    return;
+  }
+
+  const auto* process = step->GetPostStepPoint()->GetProcessDefinedStep();
+  if (process == nullptr || process->GetProcessName() == "Transportation") {
+    return;
+  }
+
+  auto* info = dynamic_cast<TrackInformation*>(track->GetUserInformation());
+  if (info == nullptr) {
+    info = new TrackInformation();
+    track->SetUserInformation(info);
+  }
+
+  // Any interaction in the scanned object means that a subsequently detected
+  // photon is not an uncollided primary.  Compton/Rayleigh are additionally
+  // tagged for diagnostics.
+  info->MarkObjectInteraction();
+  const G4String processName = process->GetProcessName();
+  if (processName == "compt" || processName == "Compton") {
+    info->MarkCompton();
+  } else if (processName == "Rayl" || processName == "rayl") {
+    info->MarkRayleigh();
+  }
+}

diff -ruN /mnt/data/geant4_proj/geant4#U9879#U76ee/include/TrackInformation.hh /mnt/data/geant4_scatter_truth_v1/include/TrackInformation.hh
--- /mnt/data/geant4_proj/geant4#U9879#U76ee/include/TrackInformation.hh	2026-04-28 12:08:12.000000000 +0000

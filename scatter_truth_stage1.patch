+#!/usr/bin/env python3
+"""Validate SDS Geant4 primary/scatter truth arrays.
+
+Example
+-------
+python tools/check_scatter_truth.py \
+    --prefix ../output_scatter_truth/Front_obj_test_000_ \
+    --air-prefix ../output_scatter_truth/Front_air_test_000_ \
+    --outdir ../output_scatter_truth/check_front
+
+The prefix is the common filename prefix before
+"signal_total_f64.raw", etc.
+"""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import numpy as np
+
+
+def read_meta(path: Path) -> dict[str, str]:
+    meta: dict[str, str] = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        meta[key.strip()] = value.strip()
+    return meta
+
+
+def load_triplet(prefix: str):
+    p = Path(prefix)
+    meta_path = Path(str(p) + "signal_meta.txt")
+    if not meta_path.exists():
+        raise FileNotFoundError(f"Missing metadata: {meta_path}")
+    meta = read_meta(meta_path)
+    nz = int(meta["n_z"])
+    nt = int(meta["n_theta"])
+    n = nz * nt
+
+    def load(suffix: str) -> np.ndarray:
+        path = Path(str(p) + suffix)
+        arr = np.fromfile(path, dtype=np.float64)
+        if arr.size != n:
+            raise ValueError(
+                f"{path}: expected {n} values ({nz}x{nt}), got {arr.size}"
+            )
+        return arr.reshape(nz, nt)
+
+    total = load("signal_total_f64.raw")
+    primary = load("signal_primary_f64.raw")
+    scatter = load("signal_scatter_f64.raw")
+    return meta, total, primary, scatter
+
+
+def safe_rel_l2(a: np.ndarray, b: np.ndarray) -> float:
+    den = np.linalg.norm(b.ravel())
+    return float(np.linalg.norm((a - b).ravel()) / den) if den > 0 else 0.0
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--prefix", required=True, help="Object-scan common prefix")
+    ap.add_argument("--air-prefix", default=None, help="Optional air-scan common prefix")
+    ap.add_argument("--outdir", required=True)
+    args = ap.parse_args()
+
+    outdir = Path(args.outdir)
+    outdir.mkdir(parents=True, exist_ok=True)
+
+    meta, total, primary, scatter = load_triplet(args.prefix)
+    closure = total - primary - scatter
+    closure_rel = safe_rel_l2(primary + scatter, total)
+
+    sum_p = float(primary.sum())
+    sum_s = float(scatter.sum())
+    global_spr = sum_s / sum_p if sum_p > 0 else np.nan
+
+    positive_p = primary > 0
+    spr = np.zeros_like(primary)
+    spr[positive_p] = scatter[positive_p] / primary[positive_p]
+
+    lines = [
+        "SDS scatter-truth validation",
+        f"shape = {total.shape} (z, theta)",
+        f"unit = {meta.get('unit', 'unknown')}",
+        f"object_enabled = {meta.get('object_enabled', 'unknown')}",
+        f"closure_rel_L2 = {closure_rel:.12e}",
+        f"closure_max_abs = {np.max(np.abs(closure)):.12e}",
+        f"sum_total = {total.sum():.12e}",
+        f"sum_primary = {sum_p:.12e}",
+        f"sum_scatter = {sum_s:.12e}",
+        f"global_SPR=sum(S)/sum(P) = {global_spr:.8f}",
+    ]
+
+    air = None
+    if args.air_prefix:
+        air_meta, air_total, air_primary, air_scatter = load_triplet(args.air_prefix)
+        if air_total.shape != total.shape:
+            raise ValueError("Air/object detector shapes differ")
+        air = air_total
+        air_scatter_fraction = (
+            float(air_scatter.sum() / air_total.sum()) if air_total.sum() > 0 else np.nan
+        )
+        lines.extend(
+            [
+                f"air_object_enabled = {air_meta.get('object_enabled', 'unknown')}",
+                f"air_scatter_fraction = {air_scatter_fraction:.12e}",
+            ]
+        )
+
+    report = "\n".join(lines) + "\n"
+    print(report)
+    (outdir / "validation.txt").write_text(report, encoding="utf-8")
+
+    np.savez_compressed(
+        outdir / "scatter_truth_arrays.npz",
+        total=total,
+        primary=primary,
+        scatter=scatter,
+        closure=closure,
+        spr=spr,
+        **({"air": air} if air is not None else {}),
+    )
+
+    try:
+        import matplotlib.pyplot as plt
+    except Exception as exc:  # pragma: no cover
+        print(f"matplotlib unavailable; skip PNG plots: {exc}")
+        return
+
+    def save_map(arr: np.ndarray, name: str, title: str):
+        fig, ax = plt.subplots(figsize=(8, 4.5))
+        im = ax.imshow(arr, origin="lower", aspect="auto")
+        ax.set_xlabel("Detector theta index")
+        ax.set_ylabel("Detector z index")
+        ax.set_title(title)
+        fig.colorbar(im, ax=ax)
+        fig.tight_layout()
+        fig.savefig(outdir / name, dpi=180)
+        plt.close(fig)
+
+    save_map(total, "01_total.png", "Total detector entrance signal")
+    save_map(primary, "02_primary.png", "Primary (uncollided) signal")
+    save_map(scatter, "03_scatter.png", "Object-scatter signal")
+    save_map(spr, "04_spr.png", "Scatter-to-primary ratio (SPR)")
+    save_map(closure, "05_closure.png", "Closure residual: total-primary-scatter")
+
+    # Profiles through detector center.
+    iz = total.shape[0] // 2
+    it = total.shape[1] // 2
+
+    fig, ax = plt.subplots(figsize=(8, 4.5))
+    ax.plot(total[iz], label="Total")
+    ax.plot(primary[iz], label="Primary")
+    ax.plot(scatter[iz], label="Scatter")
+    ax.set_xlabel("Detector theta index")
+    ax.set_ylabel("Signal (keV)")
+    ax.set_title("Central-z horizontal profile")
+    ax.legend()
+    fig.tight_layout()
+    fig.savefig(outdir / "06_profile_theta.png", dpi=180)
+    plt.close(fig)
+
+    fig, ax = plt.subplots(figsize=(8, 4.5))
+    ax.plot(total[:, it], label="Total")
+    ax.plot(primary[:, it], label="Primary")
+    ax.plot(scatter[:, it], label="Scatter")
+    ax.set_xlabel("Detector z index")
+    ax.set_ylabel("Signal (keV)")
+    ax.set_title("Central-theta vertical profile")
+    ax.legend()
+    fig.tight_layout()
+    fig.savefig(outdir / "07_profile_z.png", dpi=180)
+    plt.close(fig)
+
+
+if __name__ == "__main__":
+    main()

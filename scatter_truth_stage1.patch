@@ -2,24 +2,60 @@
 #define TrackInformation_h 1
 
 #include "G4VUserTrackInformation.hh"
+#include "globals.hh"
 
+// Per-track history used for clean primary/scatter classification.
+// "Scatter" here means the photon (or one of its ancestors) has interacted
+// with the scanned object before reaching the detector.  This makes
+// primary = uncollided object transmission, scatter = all object-interacted
+// photon signal.  Additional Compton/Rayleigh flags are kept for diagnostics.
 class TrackInformation : public G4VUserTrackInformation
 {
   public:
     TrackInformation() = default;
-    explicit TrackInformation(G4bool hasScattered)
-      : fHasScattered(hasScattered)
+    explicit TrackInformation(G4bool hasObjectInteraction)
+      : fHasObjectInteraction(hasObjectInteraction)
     {}
     TrackInformation(const TrackInformation&) = default;
     ~TrackInformation() override = default;
 
-    void MarkScattered() { fHasScattered = true; }
-    G4bool HasScattered() const { return fHasScattered; }
+    void MarkScattered() { fHasObjectInteraction = true; }
+    void MarkObjectInteraction() { fHasObjectInteraction = true; }
+    G4bool HasScattered() const { return fHasObjectInteraction; }
+    G4bool HasObjectInteraction() const { return fHasObjectInteraction; }
+
+    void MarkCompton()
+    {
+      fHasObjectInteraction = true;
+      fHasCompton = true;
+    }
+    void MarkRayleigh()
+    {
+      fHasObjectInteraction = true;
+      fHasRayleigh = true;
+    }
+    G4bool HasCompton() const { return fHasCompton; }
+    G4bool HasRayleigh() const { return fHasRayleigh; }
+
+    // Ideal detector-entry scoring must count a track lineage only once.
+    void MarkDetectorEntered() { fHasEnteredDetector = true; }
+    G4bool HasEnteredDetector() const { return fHasEnteredDetector; }
+
+    void InheritFrom(const TrackInformation& parent)
+    {
+      if (parent.fHasObjectInteraction) fHasObjectInteraction = true;
+      if (parent.fHasCompton) fHasCompton = true;
+      if (parent.fHasRayleigh) fHasRayleigh = true;
+      if (parent.fHasEnteredDetector) fHasEnteredDetector = true;
+    }
 
     void Print() const override {}
 
   private:
-    G4bool fHasScattered = false;
+    G4bool fHasObjectInteraction = false;
+    G4bool fHasCompton = false;
+    G4bool fHasRayleigh = false;
+    G4bool fHasEnteredDetector = false;
 };
 
 #endif
